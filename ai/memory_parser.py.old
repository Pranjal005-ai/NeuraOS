"""
=========================================================
File: memory_parser.py
Author: Pranjal

Purpose:
Extract useful information from user commands that
should be stored in memory.
=========================================================
"""

import re


def parse_memory(command):

    command = command.lower().strip()

    patterns = [

        (r"my name is (.+)", "name"),
        (r"i am (.+)", "name"),
        (r"my favorite color is (.+)", "favorite_color"),
        (r"my favourite color is (.+)", "favorite_color"),
        (r"my favorite food is (.+)", "favorite_food"),
        (r"my favourite food is (.+)", "favorite_food"),
        (r"i live in (.+)", "city"),
        (r"my city is (.+)", "city"),
        (r"my birthday is (.+)", "birthday"),

    ]

    for pattern, key in patterns:

        match = re.search(pattern, command)

        if match:

            value = match.group(1).strip()

            return key, value

    return None